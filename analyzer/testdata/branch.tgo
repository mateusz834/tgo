package templates

import "github.com/mateusz834/tgo"

func test1(tgo.Ctx) error {
	for _, v := range "a" {
		<div>
			break
		</div>
	}

	for _, v := range "a" {
		<div>
			if v == 'a' {
				break
			}
		</div>
	}

	for _, v := range "a" {
		<div>
			continue
		</div>
	}

	for true {
		<div>
			break
		</div>
	}

	for true {
		<div>
			continue
		</div>
	}

	switch "test" {
	case "test":
		<div>
			break
		</div>
	case "test2":
		<div>
		</div>
		fallthrough
	default:
		<div>
			break
		</div>
	}

	switch any("test").(type) {
	case int:
		<div>
			break
		</div>
	default:
		<div>
			break
		</div>
	}

	select {
	case <-make(chan int):
		<div>
			break
		</div>
	default:
		<div>
			break
		</div>
	}

	<div>
		return nil
	</div>
}

func test2(tgo.Ctx) error {
	for {
		<div>
			for _, v := range "a" {
				if v == 'a' {
					break
				}
			}
		</div>
	}

outer:
	for {
		<div>
			for _, v := range "a" {
				if v == 'a' {
					break outer
				} else {
					continue outer
				}
			}
		</div>
	}
}

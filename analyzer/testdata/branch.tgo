package templates

import "github.com/mateusz834/tgo"

func test(tgo.Ctx) error {
	for _, v := range "a" {
		<div>
			break // ERROR: col(4): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	}

	for _, v := range "a" {
		<div>
			if v == 'a' {
				break // ERROR: col(5): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
			}
		</div>
	}

	for _, v := range "a" {
		<div>
			continue // ERROR: col(4): "unexpected continue statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	}

	for true {
		<div>
			break // ERROR: col(4): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	}

	for true {
		<div>
			continue // ERROR: col(4): "unexpected continue statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	}

	switch "test" {
	case "test":
		<div>
			break // ERROR: col(4): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	case "test2":
		<div>
		</div>
		fallthrough
	default:
		<div>
			break // ERROR: col(4): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	}

	switch any("test").(type) {
	case int:
		<div>
			break // ERROR: col(4): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	default:
		<div>
			break // ERROR: col(4): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	}

	select {
	case <-make(chan int):
		<div>
			break // ERROR: col(4): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	default:
		<div>
			break // ERROR: col(4): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
		</div>
	}

	<div>
		return nil // ERROR: col(3): "unexpected return statement in the middle of a tag body, ensure that all open tags are closed"
	</div>
}

func test(tgo.Ctx) error {
	<div>
		return nil // ERROR: col(3): "unexpected return statement in the middle of a tag body, ensure that all open tags are closed"
	</div>
	return nil
}

func test(tgo.Ctx) error {
	for {
		<div>
			for _, v := range "a" {
				if v == 'a' {
					break
				}
			}
		</div>
	}

outer:
	for {
		<div>
			for _, v := range "a" {
				if v == 'a' {
					break outer // ERROR: col(6): "unexpected break statement in the middle of a tag body, ensure that all open tags are closed"
				} else if v == 'b' {
					continue outer // ERROR: col(6): "unexpected continue statement in the middle of a tag body, ensure that all open tags are closed"
				} else if v == 'c' {
					break
				} else {
					continue
				}
			}
		</div>
	}
}

func test(tgo.Ctx) error {
	<div>
		goto end // ERROR: col(3): "unexpected goto statement, ensure that all tags are closed at the goto and the jump locaton"
	</div>

end:
	panic("test")
}

func test(tgo.Ctx) error {
	if true {
		goto end // ERROR: col(3): "unexpected goto statement, ensure that all tags are closed at the goto and the jump locaton"
	}

	<div>
	end:
		"oops"
	</div>
}

func test(tgo.Ctx) error {
	<div>
	start:
		"oops"
	</div>

	if true {
		goto start // ERROR: col(3): "unexpected goto statement, ensure that all tags are closed at the goto and the jump locaton"
	}
}

func test(tgo.Ctx) error {
start:
	"str"
	<div>
	</div>

	if true {
		goto start
	}

}

func test(tgo.Ctx) error {
	<div>
		if true {
			goto end
		}
	end:
		"a"
	</div>
}

func test(tgo.Ctx) error {
	<div>
	start:
		"a"
		if true {
			goto start
		}
	</div>
}

func test(tgo.Ctx) error {
	<div>
		if true {
			goto end // ERROR: col(4): "unexpected goto statement, ensure that all tags are closed at the goto and the jump locaton"
		}
		<div>
		end:
			"a"
		</div>
	</div>
}


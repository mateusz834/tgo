func test1(tgo.Ctx) error {
	<div>
	</div>
}

func test2(tgo.Ctx) error {
	<div> // ERROR: col(2): unclosed tag
}

func test3(tgo.Ctx) error {
	</div> // ERROR: col(2): missing open tag
}

func test4(tgo.Ctx) error {
	<div>
	</span> // ERROR: col(2): unexpected close tag: "span", want: "div"
}


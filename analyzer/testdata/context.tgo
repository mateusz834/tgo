package templates

import "github.com/mateusz834/tgo"

func test1(tgo.Ctx) error {
	<div
		@attr1
		@attr2="value"
		@attr3="value \{"test"}"

		if a == 3 {
			@attr4
		}

		for true {
			@attr5
		}

		for _,v := range "test" {
			@attr6
		}

		l: for _,v := range "test" {
			@attr6
			break l
		}

		switch "test" {
		case "test":
			@attr7
		default:
			@attr8
		}

		select {
		case _ = <-make(chan int):
			@attr9
		default:
			@attr10
		}

		{
			@attr11
		}

		switch v.(type) {
		case int:
			@attr12
		default:
			@attr13
		}
	>
		"test"
		"\{"test"}"
	</div>
	_ = func(tgo.Ctx) error {
		<div
			@attr1
			@attr2="value"
			@attr3="value \{"test"}"
		>
			"test"
			"\{"test"}"
			if a == 3 {
				"test"
				"\{"test"}"
			}

			for true {
				"test"
				"\{"test"}"
			}

			for _,v := range "test" {
				"test"
				"\{"test"}"
			}

			l: for _,v := range "test" {
				"test"
				"\{"test"}"
				break l
			}

			switch "test" {
			case "test":
				"test"
				"\{"test"}"
			default:
				"test"
				"\{"test"}"
			}

			select {
			case _ = <-make(chan int):
				"test"
				"\{"test"}"
			default:
				"test"
				"\{"test"}"
			}

			{
				"test"
				"\{"test"}"
			}

			switch v.(type) {
			case int:
				"test"
				"\{"test"}"
			default:
				"test"
				"\{"test"}"
			}
		</div>
	}
}

func test2(tgo.Ctx) error {
	<div
		"\{"test"}"
		"test"
	>
		@attr1
		@attr2="value"
		@attr3="value \{"test"}"
	</div>
	_ = func(tgo.Ctx) error {
		<div
			"\{"test"}"
			"test"
		>
			@attr1
			@attr2="value"
			@attr3="value \{"test"}"
		</div>
	}
}

func test3() {
	<div>
	</div>
	@attr1
	@attr2="value"
	@attr3="value \{"test"}"
	"test"
	"\{"test"}"
	_ = func() {
		<div>
		</div>
		@attr1
		@attr2="value"
		@attr3="value \{"test"}"
		"test"
		"\{"test"}"
	}
}

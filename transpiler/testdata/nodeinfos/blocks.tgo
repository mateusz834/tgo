package templates

import "github.com/mateusz834/tgo"

func _(ctx tgo.Ctx) error {
	a := 3
	<div>
		for i := range 3 {
			<div>"\{i}"</div>

			if i == 2 {
				"two"
			}

			switch t {
			case 1:
				one := "one"
				"one"
				"\{one}"
			default:
				test := "sth else"
				"test"
				"\{test}"
			}

			select {
			case <-a:
				<div
					@val1attr="\{val1}"
				>
					"\{test1}"
				</div>
			default:
				<div
					@val1attr="\{val2}"
				>
					"\{test2}"
				</div>
			}
		}
	</div>

	_ = func(tgo tgo.Ctx) error {
		<div>"\{test}"</div>
	}
}
